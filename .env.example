# Supabase Configuration (Required for General Audience Hosting / Database Persistence)
# Obtain these from your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# Optional: Background WhatsApp Broadcast Gateway (Meta WhatsApp Cloud API or Twilio)
# Note: If omitted, the app automatically runs the built-in 100% Free Bulk WhatsApp Queue runner!
# META_WHATSAPP_TOKEN=EAAG...
# META_WHATSAPP_PHONE_ID=109...
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
