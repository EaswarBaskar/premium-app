# ==============================================================================
# TRAXVA SECURITY & ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Never commit real secrets, API keys, or passcodes to Git.
# Copy this file to .env.local for local development.
# ==============================================================================

# Application URL (Used for CORS and canonical URL generation)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration (Required for General Audience Hosting / Database Persistence)
# Obtain these from your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key-here

# Superadmin Console Protection
# Choose a strong passcode (minimum 12 characters recommended)
ADMIN_PASSCODE=your-secure-admin-passcode-here

# Google OAuth (Configure inside Supabase Dashboard: Authentication -> Providers -> Google)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional: WhatsApp Broadcast Gateway (Meta WhatsApp Cloud API or Twilio)
# If omitted, the app runs the built-in free client-side WhatsApp queue runner.
# META_WHATSAPP_TOKEN=EAAG...
# META_WHATSAPP_PHONE_ID=109...
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
